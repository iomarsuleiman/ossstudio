{
  "name": "the-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Open Source Gallery — a calm, bilingual 3D art gallery of open-source software and open AI models.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "seed": "convex run seed:run",
    "test": "vitest run",
    "bench": "node scripts/perf-bench.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "capacity": "node scripts/capacity-model.mjs",
    "dev:backend": "tsx scripts/dev-backend.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "convex": "^1.49.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "convex-test": "^0.0.67",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  },
  "engines": {
    "node": ">=20"
  }
}
