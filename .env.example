# Convex deployment URL. Printed by `npx convex dev` (dev) or found in the
# Convex dashboard (prod). Without it the site serves the bundled catalogue.
NEXT_PUBLIC_CONVEX_URL=

# Optional: try live features locally without Convex. Run `npm run dev:backend`
# and point the gallery at it (development only):
# NEXT_PUBLIC_MP_DEV=http://localhost:3210
#
# Live-feature settings live in Convex, not here:
#   npx convex env set GALLERY_CAPACITY 500
#   npx convex env set QUEUE_OWNER_KEY <long random string>
